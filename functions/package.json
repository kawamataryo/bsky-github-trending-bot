{
  "name": "functions",
  "type": "module",
  "scripts": {
    "test:post": "npm run build && node scripts/test-post-text.mjs",
    "lint": "npm run format",
    "format": "prettier -w ./src",
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
