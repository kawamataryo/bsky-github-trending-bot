    "ai": "^5.0.0",
    "cheerio": "^1.0.0-rc.12",
    "dayjs": "^1.11.10",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^7.0.4",
    "node-fetch": "^3.3.2",
    "node-html-parser": "^6.1.13",
    "open-graph-scraper": "^6.5.1",
    "sharp": "^0.33.3",
    "twitter-api-v2": "^1.16.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "firebase-functions-test": "^3.2.0",
    "prettier": "^3.2.5",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.2"
